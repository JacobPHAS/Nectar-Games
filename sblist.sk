# =========================================================
# SPEED BUILDERS BUILD MANAGER
# =========================================================


# =========================================================
# SB LIST
# =========================================================

command /sblist:
    permission: op
    trigger:

        delete {sb.manager.slot::%uuid of player%::*}

        if size of {sb.templates::*} <= 0:
            send "&6&lNectar &8» &cNo Speed Builders builds saved."
            stop

        set {_inv} to chest inventory with 6 rows named "&8SB BUILDS"

        set {_slot} to 0

        loop {sb.templates::*}:

            if {_slot} >= 45:
                stop loop

            set {_id} to loop-value
            set {_name} to {sb.template.name::%{_id}%}
            set {_author} to {sb.template.author::%{_id}%}

            if {_name} is not set:
                set {_name} to "Unknown"

            if {_author} is not set:
                set {_author} to "Unknown"

            set slot {_slot} of {_inv} to bricks named "&e&l%{_name}%" with lore "&7Author: &f%{_author}%" and "" and "&aClick to manage"

            set {sb.manager.slot::%uuid of player%::%{_slot}%} to {_id}

            add 1 to {_slot}

        set slot 49 of {_inv} to barrier named "&c&lCLOSE"

        open {_inv} to player


# =========================================================
# CLICK BUILD
# =========================================================

on inventory click:

    if name of event-inventory is "&8SB BUILDS":

        cancel event

        if clicked slot is 49:
            close player's inventory
            stop

        if clicked slot is 0:
            make player execute command "/sbmanage 0"
            stop

        if clicked slot is 1:
            make player execute command "/sbmanage 1"
            stop

        if clicked slot is 2:
            make player execute command "/sbmanage 2"
            stop

        if clicked slot is 3:
            make player execute command "/sbmanage 3"
            stop

        if clicked slot is 4:
            make player execute command "/sbmanage 4"
            stop

