# =========================================================
# OPEN MANAGE MENU
# =========================================================

command /sbmanage <number>:
    permission: op
    trigger:

        set {_id} to {sb.manager.slot::%uuid of player%::%arg-1%}

        if {_id} is not set:
            send "&6&lNectar &8» &cThat build does not exist."
            stop

        set {sb.manager.selected::%uuid of player%} to {_id}

        set {_name} to {sb.template.name::%{_id}%}

        if {_name} is not set:
            set {_name} to "Unknown"

        set {_menu} to chest inventory with 3 rows named "&8SB MANAGE"

        set slot 10 of {_menu} to name tag named "&b&lRENAME"
        set slot 11 of {_menu} to lime wool named "&a&lEDIT BUILD"
        set slot 13 of {_menu} to bricks named "&e&l%{_name}%"
        set slot 15 of {_menu} to red wool named "&c&lDELETE BUILD"
        set slot 22 of {_menu} to arrow named "&7&lBACK"

        open {_menu} to player


# =========================================================
# MANAGE CLICK
# =========================================================

on inventory click:

    if name of event-inventory is "&8SB MANAGE":

        cancel event

        set {_id} to {sb.manager.selected::%uuid of player%}

        if {_id} is not set:
            close player's inventory
            stop


        # =================================================
        # RENAME
        # =================================================

        if clicked slot is 10:

            close player's inventory

            set {sb.manager.rename::%uuid of player%} to true

            send ""
            send "&6&lNectar &8» &e&lRENAME BUILD"
            send "&7Type the new build name in chat."
            send "&7Type &cCancel &7to cancel."
            send ""

            stop


        # =================================================
        # EDIT
        # =================================================

        if clicked slot is 11:

            close player's inventory

            set {_uuid} to uuid of player
            set {sb.manager.editing::%{_uuid}%} to {_id}
            set {sb.manager.origin::%{_uuid}%} to location of block at player

            set {_origin} to {sb.manager.origin::%{_uuid}%}

            set {_x} to 0

            while {_x} < 5:

                set {_z} to 0

                while {_z} < 5:

                    set {_loc} to {_origin}
                    add {_x} to x-coordinate of {_loc}
                    add {_z} to z-coordinate of {_loc}

                    set {_data} to {sb.template.data::%{_id}%::%{_x}%::%{_z}%}

                    if {_data} is set:
                        set block at {_loc} to {_data}

                    else:
                        set block at {_loc} to air

                    add 1 to {_z}

                add 1 to {_x}

            send "&6&lNectar &8» &aBuild loaded for editing!"
            send "&7Edit the 5x5 area."
            send "&7Use &e/sbsaveedit &7when finished."
            stop


        # =================================================
        # DELETE
        # =================================================

        if clicked slot is 15:

            set {_name} to {sb.template.name::%{_id}%}

            if {_name} is not set:
                set {_name} to "Unknown"

            set {_confirm} to chest inventory with 3 rows named "&8SB DELETE"

            set slot 11 of {_confirm} to red wool named "&c&lDELETE"
            set slot 13 of {_confirm} to paper named "&e%{_name}%"
            set slot 15 of {_confirm} to lime wool named "&a&lCANCEL"

            open {_confirm} to player
            stop


        # =================================================
        # BACK
        # =================================================

        if clicked slot is 22:

            close player's inventory

            make player execute command "/sblist"

            stop


# =========================================================
# DELETE CLICK
# =========================================================

on inventory click:

    if name of event-inventory is "&8SB DELETE":

        cancel event

        set {_id} to {sb.manager.selected::%uuid of player%}

        if {_id} is not set:
            close player's inventory
            stop


        if clicked slot is 11:

            set {_name} to {sb.template.name::%{_id}%}

            if {_name} is not set:
                set {_name} to "Unknown"

            remove {_id} from {sb.templates::*}

            delete {sb.template.data::%{_id}%::*}
            delete {sb.template.type::%{_id}%::*}
            delete {sb.template.name::%{_id}%}
            delete {sb.template.author::%{_id}%}

            delete {sb.manager.selected::%uuid of player%}
            delete {sb.manager.slot::%uuid of player%::*}

            close player's inventory

            send "&6&lNectar &8» &aDeleted &e%{_name}%&a."

            stop


        if clicked slot is 15:

            close player's inventory

            make player execute command "/sblist"

            stop


# =========================================================
# RENAME CHAT INPUT
# =========================================================

on chat:

    if {sb.manager.rename::%uuid of player%} is not true:
        stop

    cancel event

    set {_id} to {sb.manager.selected::%uuid of player%}

    if {_id} is not set:

        delete {sb.manager.rename::%uuid of player%}

        send "&6&lNectar &8» &cNo build is selected."

        stop


    # CANCEL

    if message is "Cancel":
        delete {sb.manager.rename::%uuid of player%}

        send "&6&lNectar &8» &cRename cancelled."

        make player execute command "/sblist"

        stop


    # EMPTY NAME

    if message is "":
        send "&6&lNectar &8» &cThe build name cannot be empty."
        send "&7Type the new name in chat."
        stop


    # RENAME

    set {_oldName} to {sb.template.name::%{_id}%}

    if {_oldName} is not set:
        set {_oldName} to "Unknown"

    set {sb.template.name::%{_id}%} to message

    delete {sb.manager.rename::%uuid of player%}

    send "&6&lNectar &8» &aRenamed &e%{_oldName}% &ato &e%message%&a."

    wait 2 ticks

    make player execute command "/sblist"


# =========================================================
# SAVE EDIT
# =========================================================

command /sbsaveedit:
    permission: op
    trigger:

        set {_uuid} to uuid of player
        set {_id} to {sb.manager.editing::%{_uuid}%}
        set {_origin} to {sb.manager.origin::%{_uuid}%}

        if {_id} is not set:
            send "&6&lNectar &8» &cYou are not editing a build."
            stop

        if {_origin} is not set:
            send "&6&lNectar &8» &cNo edit location found."
            stop

        delete {sb.template.data::%{_id}%::*}
        delete {sb.template.type::%{_id}%::*}

        set {_x} to 0

        while {_x} < 5:

            set {_z} to 0

            while {_z} < 5:

                set {_loc} to {_origin}

                add {_x} to x-coordinate of {_loc}
                add {_z} to z-coordinate of {_loc}

                set {sb.template.data::%{_id}%::%{_x}%::%{_z}%} to block data of block at {_loc}
                set {sb.template.type::%{_id}%::%{_x}%::%{_z}%} to type of block at {_loc}

                add 1 to {_z}

            add 1 to {_x}

        set {_name} to {sb.template.name::%{_id}%}

        delete {sb.manager.editing::%{_uuid}%}
        delete {sb.manager.origin::%{_uuid}%}

        send "&6&lNectar &8» &aBuild &e%{_name}% &ahas been saved!"


# =========================================================
# CLEANUP
# =========================================================

on quit:

    delete {sb.manager.slot::%uuid of player%::*}
    delete {sb.manager.selected::%uuid of player%}
    delete {sb.manager.editing::%uuid of player%}
    delete {sb.manager.origin::%uuid of player%}
    delete {sb.manager.rename::%uuid of player%}